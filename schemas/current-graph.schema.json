{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometeo.current-graph/v1",
  "type": "object",
  "required": [
    "schema",
    "revision",
    "artifacts",
    "pointers",
    "active_workstream"
  ],
  "properties": {
    "schema": {
      "const": "prometeo.current-graph/v1"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "artifacts": {
      "type": "object"
    },
    "pointers": {
      "type": "object"
    }
  }
}