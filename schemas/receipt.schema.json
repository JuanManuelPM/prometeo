{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometeo.receipt/v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "type",
    "prev_hash",
    "operation_id",
    "base_artifact",
    "source_digests",
    "files_changed",
    "output_digests",
    "tests",
    "privacy_decisions",
    "timestamp",
    "hash"
  ],
  "properties": {
    "schema": {
      "const": "prometeo.receipt/v1"
    },
    "hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    }
  }
}
