{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometeo.raw-record/v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "kind",
    "privacy",
    "source_ref",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "prometeo.raw-record/v1"
    },
    "privacy": {
      "enum": [
        "PUBLIC",
        "PROJECT",
        "LOCAL"
      ]
    },
    "authority": {
      "const": "RAW_UNCURATED"
    }
  }
}