{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometeo.verification-result/v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "work_item_id",
    "result",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "prometeo.verification-result/v1"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    }
  }
}
