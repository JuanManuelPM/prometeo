{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometeo.context-pack/v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "work_item_id",
    "target",
    "included",
    "excluded",
    "privacy",
    "source_digests",
    "reopen_handles"
  ],
  "properties": {
    "schema": {
      "const": "prometeo.context-pack/v1"
    },
    "id": {
      "type": "string"
    },
    "included": {
      "type": "array"
    },
    "excluded": {
      "type": "array"
    },
    "privacy": {
      "enum": [
        "PUBLIC",
        "PROJECT",
        "LOCAL"
      ]
    }
  }
}