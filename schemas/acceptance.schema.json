{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometeo.acceptance/v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "candidate_id",
    "decision",
    "exact_identity"
  ],
  "properties": {
    "schema": {
      "const": "prometeo.acceptance/v1"
    },
    "decision": {
      "enum": [
        "ACCEPT",
        "REJECT",
        "REQUEST_CHANGE"
      ]
    }
  }
}
