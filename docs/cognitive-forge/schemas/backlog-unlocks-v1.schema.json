{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juanmanuelpm.github.io/prometeo/docs/cognitive-forge/schemas/backlog-unlocks-v1.schema.json",
  "title": "Prometeo backlog unlocked capability contract v1",
  "type": "object",
  "required": [
    "id",
    "status",
    "title",
    "summary",
    "unlocks"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "unlocks": {
      "type": "object",
      "required": [
        "capability",
        "effect"
      ],
      "additionalProperties": false,
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": true
}
