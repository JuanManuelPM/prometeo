{
  "id":"prometeo-study-ui",
  "major":1,
  "version":"1.0.0",
  "owner":"JuanManuelPM/prometeo/shared/study/v1",
  "studentDataIsContent":true,
  "states":{"subject":["locked","new","progress","done"]},
  "components":["SubjectState","Disclosure","LockIcon","ResourceLink","MathRenderer","InlineAnswer","ExerciseRow","HintSteps"],
  "invariants":[
    "selection != activation",
    "scroll/drag != click",
    "one semantic state slot",
    "same typography role across hierarchy depths",
    "no unicode lock/chevron icons",
    "printed math instead of code-like math",
    "student-specific content never owns shared CSS/JS",
    "breaking changes require a new major version"
  ]
}
