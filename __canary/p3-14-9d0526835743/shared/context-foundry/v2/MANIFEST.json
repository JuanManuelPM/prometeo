{
  "schema": "prometeo.context-foundry-manifest/v2",
  "pipeline": [
    "BYTES",
    "INDEXED",
    "RETRIEVABLE",
    "CURATED",
    "AUTHORITY",
    "PRIVACY",
    "SELECTED",
    "CONSUMED",
    "REOPENABLE"
  ],
  "rules": [
    "EXISTS != PARTICIPATES",
    "explicit IDs do not bypass privacy",
    "derived privacy inherits strongest source",
    "superseded current truth excluded unless historical",
    "high-authority contradictions fail closed",
    "deterministic selection",
    "selection explains inclusion/exclusion"
  ]
}
