{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"prometeo.receipt/v1",
  "title":"Prometeo Evidence Receipt",
  "type":"object",
  "required":["operation_id","base","candidate","changes","tests","truth_ceiling","promotion"],
  "properties":{
    "operation_id":{"type":"string"},
    "base":{"type":"object","required":["ref"],"properties":{"ref":{"type":"string"},"sha256":{"type":["string","null"]}}},
    "candidate":{"type":"object","required":["ref"],"properties":{"ref":{"type":"string"},"sha256":{"type":["string","null"]},"bytes":{"type":["integer","null"]}}},
    "changes":{"type":"array","items":{"type":"object","required":["path","kind"],"properties":{"path":{"type":"string"},"kind":{"enum":["CREATE","UPDATE","DELETE","MOVE"]},"before_sha256":{"type":["string","null"]},"after_sha256":{"type":["string","null"]}}}},
    "tests":{"type":"array","items":{"type":"object","required":["id","layer","status"],"properties":{"id":{"type":"string"},"layer":{"enum":["MODEL","STATIC","UNIT","RUNTIME","BROWSER","VISUAL","HUMAN","SERVED"]},"status":{"enum":["PASS","FAIL","BLOCKED","NOT_RUN","NOT_APPLICABLE"]},"evidence":{"type":["string","object","array","null"]}}}},
    "truth_ceiling":{"type":"array","items":{"type":"string"}},
    "promotion":{"type":"object","required":["state"],"properties":{"state":{"enum":["CANDIDATE","HUMAN_ACCEPTED","SERVED","ARCHIVED"]},"human_acceptance_required":{"type":"boolean"}}},
    "rollback":{"type":"object","properties":{"base_ref":{"type":["string","null"]},"tested_a_b_a":{"type":"boolean"}}}
  },
  "additionalProperties":true
}
