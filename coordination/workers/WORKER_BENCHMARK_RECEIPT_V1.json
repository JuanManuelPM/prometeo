{
  "schema": "prometeo.worker-benchmark-receipt-spec/v1",
  "receipt_id": "WORKER-BENCHMARK-RECEIPT-V1",
  "status": "ACTIVE_BINDING",
  "updated_at": "2026-09-19T16:24:59.017Z",
  "path_pattern": "coordination/workers/benchmark-receipts/<run_id>/<worker_id>.json",
  "required_fields": [
    "schema",
    "run_id",
    "worker_id",
    "launch_nonce",
    "slot_id",
    "evolution_variant",
    "primary_project_id",
    "stage_trace",
    "hard_gates",
    "feature_evidence",
    "primary_complete",
    "reallocation_complete",
    "closed_at_or_null"
  ],
  "stage_trace_fields": [
    "E0_ENVELOPE",
    "E1_IDENTITY",
    "E2_ASSIGN",
    "E3_CONTEXT",
    "E4_PLAN_LOCK",
    "E5_PRODUCE",
    "E6_VERIFY",
    "E7_RETURN",
    "E8_REALLOCATE",
    "E9_EXAM_CLOSE"
  ],
  "stage_entry": {
    "required": [
      "status"
    ],
    "status_values": [
      "PASS",
      "FAIL",
      "BOUNDARY",
      "NOT_REACHED"
    ],
    "optional": [
      "started_at",
      "completed_at",
      "evidence_refs",
      "failure_code",
      "note"
    ]
  },
  "hard_gate_values": [
    "PASS",
    "FAIL",
    "BOUNDARY",
    "NOT_REACHED"
  ],
  "evidence_rule": "A PASS must cite exact durable evidence. A missing capability is BOUNDARY, never fabricated PASS.",
  "analysis_fields": {
    "diagnostic_only": [
      "wall_clock_seconds",
      "tokens_or_words_if_known",
      "changed_paths_count",
      "test_count",
      "context_reads_count"
    ],
    "outcome_primary": [
      "primary_complete",
      "hard_gate_pass_count",
      "reallocation_complete",
      "public_route_verified",
      "feature_evidence_complete"
    ],
    "no_speed_winner_rule": "Faster is better only between workers with equivalent hard-gate completion/evidence."
  }
}
