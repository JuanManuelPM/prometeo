{
  "schema": "prometeo.worker-mission-envelope-contract/v1",
  "contract_id": "WORKER-MISSION-ENVELOPE-V1",
  "status": "ACTIVE_COMPANION_CONTRACT",
  "purpose": "Carry bounded local multi-step autonomy inside an already-owned WorkBlock without creating scheduling, scope, claim, promotion or human-authority powers.",
  "mission_modes": [
    "LEAF",
    "AGENTIC_MISSION",
    "INTEGRATION_MISSION",
    "SPECIFICATION_MISSION"
  ],
  "legacy_default": {
    "mission_mode": "LEAF",
    "compatibility": "LEGACY_PASSTHROUGH",
    "permission_source": "EXISTING_WORKBLOCK_AND_RUNTIME",
    "rule": "A historical WorkBlock without mission_envelope keeps its existing safe behavior; this companion contract does not add or remove authority."
  },
  "explicit_agentic_default": {
    "sequence": [
      "INSPECT",
      "PLAN_LOCAL",
      "WORK",
      "TEST",
      "REPAIR_LOCAL_IF_REPAIRABLE",
      "RETEST",
      "VERIFY"
    ],
    "local_permissions": {
      "inspect": true,
      "local_plan": true,
      "patch": true,
      "test": true,
      "bounded_retry": true,
      "local_repair": true,
      "alternate_safe_path": true,
      "child_proposal": true
    },
    "limits": {
      "max_local_repairs": 2,
      "max_alternate_safe_paths": 1,
      "child_proposal_budget": 1
    }
  },
  "hard_boundaries": [
    "AUTHORIZATION",
    "SCOPE",
    "CAPABILITY",
    "HUMAN_AUTHORITY",
    "TRANSPORT_EXPLICIT_DENIAL"
  ],
  "authority_invariants": {
    "scope_expansion_allowed": false,
    "authority_expansion_allowed": false,
    "claim_authority_added": false,
    "promotion_authority_added": false,
    "scheduler_authority_added": false,
    "secret_authority_added": false,
    "allowed_scope_source": "OWNED_WORKBLOCK_ONLY"
  },
  "terminal_outcomes": [
    "DONE",
    "SAFE_PARTIAL_WITH_EVIDENCE",
    "HARD_BOUNDARY_REAL"
  ],
  "pipeline_binding": {
    "E0_E9_unchanged": true,
    "pin_claim_generation_fencing_unchanged": true,
    "submit_next_unchanged": true,
    "applies_after_ownership": true
  },
  "truth_boundary": "Companion execution semantics only. Never grants scheduling, claim, scope, promotion, secret or Human Acceptance authority."
}
