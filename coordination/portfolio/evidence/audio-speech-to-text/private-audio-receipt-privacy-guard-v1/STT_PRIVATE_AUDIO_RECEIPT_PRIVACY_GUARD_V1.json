    "authenticated_request",
    "input_class",
    "mime_type",
    "duration_bucket",
    "request_started_at",
    "request_finished_at",
    "http_status",
    "structured_phase_codes",
    "phase_timings_ms",
    "transcript_nonempty_boolean",
    "transcript_length_bucket",
    "raw_audio_persisted",
    "transcript_content_persisted",
    "credential_persisted"
  ],
  "constants": {
    "authenticated_request": true,
    "input_class": "PRIVATE_AUDIO_EPHEMERAL",
    "raw_audio_persisted": false,
    "transcript_content_persisted": false,
    "credential_persisted": false
