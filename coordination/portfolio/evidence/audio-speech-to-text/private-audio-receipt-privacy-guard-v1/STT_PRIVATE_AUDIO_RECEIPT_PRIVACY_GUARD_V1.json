    "transcript_length_bucket": "SAFE_CODE_MAX_64"
  },
  "structured_phase_codes": {
    "type": "array",
    "max_items": 32,
    "item": "SAFE_CODE_MAX_64"
  },
  "phase_timings_ms": {
    "type": "object",
    "max_properties": 32,
    "key": "SAFE_CODE_MAX_64",
    "value": "FINITE_NUMBER_0_TO_600000"
  },
  "privacy_truth_boundary": "This guard validates durable receipt bytes only. It does not prove runtime transcription success, provider retention behavior, database retention policy, Served identity, or Human Acceptance."
