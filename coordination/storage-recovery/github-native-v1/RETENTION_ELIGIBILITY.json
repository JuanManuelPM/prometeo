{
  "schema": "prometeo.retention-eligibility/v1",
  "status": "CANDIDATE_NO_DESTRUCTIVE_ACTION",
  "run_id": "PROMETEO-MP10-01",
  "purpose": "Separate compact durable terminal evidence from hot/transient runtime exhaust without inventing deletion TTLs.",
  "eligible_for_public_closure_pack": [
    {
      "class": "TERMINAL_TASK_CLOSURE",
      "requires": [
        "terminal status",
        "completion_class",
        "closed_at",
        "source_refs",
        "result_refs"
      ]
    },
    {
      "class": "INDEPENDENT_VERIFICATION_OUTCOME",
      "requires": [
        "verification_refs",
        "terminal status"
      ]
    },
    {
      "class": "PUBLIC_ARTIFACT_LINEAGE",
      "requires": [
        "changed_refs or result_refs",
        "source_refs"
      ]
    },
    {
      "class": "EXPLICIT_BOUNDARY_CLOSURE",
      "requires": [
        "completion_class=BOUNDARY",
        "boundary_codes",
        "result_refs"
      ]
    }
  ],
  "not_eligible_for_public_closure_pack": [
    "heartbeat",
    "poll event",
    "presence event",
    "last_seen",
    "intermediate progress",
    "retry chatter",
    "claim collision attempt",
    "lease refresh caused only by observation",
    "raw runtime event exhaust",
    "raw prompt",
    "chat transcript",
    "raw message body",
    "audio",
    "attachment body",
    "private execution packet",
    "raw provider payload",
    "token or credential",
    "cookie or authorization header",
    "signed URL",
    "PII/private identity payload"
  ],
  "retention_decision_law": [
    "Eligibility is semantic and evidence-based, not age-based.",
    "No TTL is guessed in this candidate.",
    "No DELETE, VACUUM, pruning, migration or database mutation is authorized by this file.",
    "Compaction must preserve reconstructible refs to canonical durable owners.",
    "Historical liveness is not restored during recovery; fresh runtime identity/epoch is required.",
    "Missing verification remains missing; compaction must not upgrade DONE to PASS."
  ],
  "future_deletion_gate": {
    "status": "BLOCKED_PENDING_MEASUREMENT_AND_EXPLICIT_AUTHORITY",
    "requires": [
      "read-only storage measurement after backend recovery",
      "class distribution measurement",
      "reconstruction test from compacted state",
      "privacy review",
      "explicit retention/deletion authority",
      "rollback or preserved baseline evidence"
    ]
  },
  "destructive_action_performed": false
}
