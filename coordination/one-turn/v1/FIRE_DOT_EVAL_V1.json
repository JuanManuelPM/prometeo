          "plan_hash": null
        }
      },
      "expected": "PLAN_INCOMPLETE"
    },
    {
      "id": "needs-other-approval",
      "overrides": {
        "protectedActionRequiresExtraApproval": true,
        "protectedActionApproved": false
      },
      "expected": "PROTECTED_ACTION_NEEDS_APPROVAL"
    },
    {
      "id": "approval-present",
      "overrides": {
        "protectedActionRequiresExtraApproval": true,
        "protectedActionApproved": true
