  "common_capsule": {
    "title": "Cat Lab",
    "primary_objective": "Build a complete static Cat Lab page end-to-end, verify it honestly, persist a benchmark receipt, then autonomously reallocate to DOG-NOTES-POOL without another human message.",
    "constraints": [
      "Static HTML/CSS/JS; no paid API; core behavior must not depend on external assets.",
      "Responsive phone + desktop.",
      "Two-color visual system; no generic dashboard/card wall.",
      "Touch + mouse + keyboard.",
      "No placeholder controls or fake success."
    ],
    "required_features": [
