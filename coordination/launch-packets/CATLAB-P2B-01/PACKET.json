        "id": "F01_PUSH_SCROLL",
        "text": "Four chapter sections with left chapter rail and push-scroll: current number stays pinned until incoming divider pushes it."
      },
      {
        "id": "F02_TTS",
        "text": "Speech-synthesis reader for chapter text: play/pause, previous/next chapter, rate control, visible current-chapter state."
      },
      {
        "id": "F03_CAT_RADIO",
        "text": "Local Cat Radio ambient audio using Web Audio or another bundled/local mechanism: play/stop and volume."
      },
      {
        "id": "F04_NOTES",
        "text": "Lightweight notes field persisted in localStorage and restored after reload."
      },
      {
        "id": "F05_PALETTES",
        "text": "Two selectable palettes with persistence."
      },
      {
        "id": "F06_RESUME",
        "text": "Restore selected chapter, TTS rate, palette and notes after reload where browser APIs permit."
      },
      {
        "id": "F07_INPUT_SAFETY",
        "text": "Keyboard/touch interactions do not steal focus from text input."
      },
      {
        "id": "F08_FALLBACK",
        "text": "Visible honest fallback when speech synthesis or audio is unavailable."
      }
    ],
