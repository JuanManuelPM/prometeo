{
  "schema": "prometeo.execution-packet-contract/v1",
  "status": "ACTIVE_CANDIDATE",
  "packet_schema": "prometeo.execution-packet/v1",
  "required": ["work_item_id","thread_id","created_at","expires_at","target","intent","baseline","context","execution","authorization","packet_hash"],
  "target": ["page_id","page_title","href","source_identity","writable_target","artifact_state"],
  "intent": {
    "selected_capture_revisions": ["capture_id","revision","ref","digest","transcript","transcript_state","page_id","created_at"],
    "attachments": ["id","file_name","mime_type","size_bytes","digest","asset_url"]
  },
  "baseline": ["current_graph_revision","current_graph_digest","catalog_identity","catalog_digest","served_identity"],
  "context": ["page_memory","previous_executions"],
  "execution": ["protocol_id","protocol_url","protocol_digest","stable_entry","repository","return_path","result_submission","rules"],
  "authorization": ["grant_scope","policy","approved_at"],
  "transport": {
    "read": "opaque >=256-bit capability URL, 7d max expiry, private/no-store/noindex",
    "attachments": "packet-scoped capability URLs; private storage remains non-public",
    "result": "sanitized GitHub RETURN at exact packet path; optional opaque private POST"
  },
  "privacy": {
    "packet": "PROJECT-private capability material",
    "github_return": "PUBLIC SANITIZED COORDINATION ONLY",
    "forbid_in_public_return": ["transcript literals","audio","attachment contents","packet URL/token","return token","workspace secret","personal sensitive payload"]
  },
  "drift_rule": "Creation bindings are evidence. Agent must revalidate current authorities before writing.",
  "completion_rule": "Chat identity is never required to recover, execute or ingest the result."
}
