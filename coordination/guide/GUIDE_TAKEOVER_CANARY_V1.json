{
  "schema": "prometeo.guide-takeover-canary/v1",
  "canary_id": "TKV1",
  "status": "ACTIVE_BINDING",
  "trigger_token": "TAKEOVER CANARY TKV1",
  "purpose": "Prove a genuinely fresh /g does more than skim durable text: it records takeover start, hydrates exact current state in order, executes material Guide work, writes back, persists the exact visible reply, and only then answers the human.",
  "truth_boundary": "This canary verifies Guide takeover quality for one fresh chat. It does not prove unattended wake or promote /w.",
  "sequence": [
    {
      "phase": "00_STARTED",
      "rule": "After loading public /g and before broad repository archaeology, create coordination/guide/takeovers/<session_id>/00_STARTED.json.",
      "required": [
        "schema",
        "session_id",
        "phase",
        "created_at",
        "trigger_token",
        "bootstrap_version",
        "human_prompt_literal",
        "canary_id"
      ]
    },
    {
      "phase": "10_HYDRATED",
      "rule": "Read required sources in order, extract concrete values, then create 10_HYDRATED.json. Do not act strategically before this proof exists.",
      "read_order": [
        ".well-known/prometeo.json + p.txt + coordination/CONTINUITY_HEAD.json",
        "coordination/guide/CURRENT_MISSION_V1.json",
        "coordination/guide/GUIDE_POWER_COMPASS_V1.json",
        "coordination/guide/GROWTH_CAMPAIGN_V1.json",
        "gh-pages:live/runtime.json",
        "gh-pages:live/claim-frontier.json",
        "gh-pages:live/worker-scoreboard.json",
        "gh-pages:guide/brief.json",
        "the exact previous visible_response_ref from CURRENT_MISSION",
        "only implicated project STATE/page contexts/receipts needed for action"
      ],
      "extracted_values_required": [
        "mission_id",
        "mission_status",
        "pool_id",
        "worker_protocol_version",
        "compounding_health",
        "campaign_stage",
        "runtime_generated_at",
        "frontier_generated_at",
        "scoreboard_generated_at",
        "leader_score",
        "champion_reproducible",
        "guide_brief_generated_at",
        "previous_visible_response_ref"
      ]
    },
    {
      "phase": "20_ACTED",
      "rule": "Execute at least one material reversible Guide action grounded by current evidence, then create 20_ACTED.json. A snapshot refresh, prose-only analysis or 'next action is /wc' does not qualify.",
      "allowed_material_action_types": [
        "PROTOCOL_MUTATION",
        "SYSTEMIC_RESCUE",
        "EXPERIMENT_ACTIVATION",
        "PROJECT_INTEGRATION",
        "PUBLIC_SURFACE_UPDATE",
        "CONTRADICTION_REPAIR",
        "FRONTIER_REPAIR",
        "CHAMPION_PROMOTION_OR_REJECTION"
      ],
      "minimum_material_actions": 1,
      "failure_rule": "If no material safe action exists, canary result is INCONCLUSIVE_OR_FAIL, never PASS."
    },
    {
      "phase": "30_FINAL",
      "rule": "Update mission/compass/campaign/project state as materially required; draft a substantive Guide response; persist exact response bytes; create 30_FINAL.json referencing the response and actions; only then emit exactly that persisted response.",
      "visible_response_required_sections": [
        "TAKEOVER",
        "QUÉ CAMBIÓ",
        "SALUD DEL PLAN",
        "PALANCAS DE POTENCIA",
        "PROYECTOS / PÁGINAS",
        "PLAN DE ARCHIVOS / EXPERIMENTOS",
        "LÍMITES REALES",
        "GUIDE BRIEF",
        "GROWTH",
        "RELEVANT PAGES",
        "/wc PROMPT",
        "HUMAN ACTION",
        "NEXT GUIDE CYCLE"
      ],
      "canary_completeness": {
        "min_visible_response_chars": 3500,
        "min_power_levers": 3,
        "min_relevant_direct_page_urls": 3,
        "require_one_executed_lever": true,
        "require_one_near_term_lever": true,
        "require_one_structural_or_creative_lever": true,
        "require_exact_wc_prompt": true,
        "require_guide_brief_url": true,
        "require_growth_url": true
      }
    }
  ],
  "anti_failure": [
    "Do not answer after only reading CURRENT_MISSION or Guide Brief.",
    "Do not count status/snapshot refresh as the material action.",
    "Do not stop merely because champion is not yet reproducible; act on the reproduction mechanism when grounded.",
    "Do not hand planning back to the human.",
    "Do not omit direct relevant page links when pages are implicated.",
    "Do not emit the final response before its exact bytes are durably persisted.",
    "Do not claim PASS if any phase artifact is absent."
  ],
  "paths": {
    "root": "coordination/guide/takeovers/<session_id>",
    "started": "00_STARTED.json",
    "hydrated": "10_HYDRATED.json",
    "acted": "20_ACTED.json",
    "final": "30_FINAL.json",
    "visible_response": "coordination/guide/visible-responses/<session_id>.md"
  },
  "validator": "scripts/check-guide-takeover-v1.mjs",
  "workflow": ".github/workflows/guide-takeover-canary.yml",
  "updated_at": "2026-09-18T15:18:00Z",
  "phase_templates": {
    "00_STARTED": {
      "schema": "prometeo.guide-takeover-phase/v1",
      "canary_id": "TKV1",
      "session_id": "TKV1-<unique>",
      "phase": "00_STARTED",
