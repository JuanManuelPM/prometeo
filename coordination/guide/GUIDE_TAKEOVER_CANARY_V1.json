      "evidence_loaded": [
        "coordination/CONTINUITY_HEAD.json",
        "coordination/guide/CURRENT_MISSION_V1.json",
        "coordination/guide/GUIDE_POWER_COMPASS_V1.json",
        "coordination/guide/GROWTH_CAMPAIGN_V1.json",
        "gh-pages:live/runtime.json",
        "gh-pages:live/claim-frontier.json",
        "gh-pages:live/worker-scoreboard.json",
        "gh-pages:guide/brief.json",
        "<exact previous visible_response_ref>"
      ],
      "observed": {
        "mission_id": "<exact>",
        "mission_status": "<exact>",
        "pool_id": "<exact>",
        "worker_protocol_version": "<exact>",
        "compounding_health": "<exact>",
        "campaign_stage": "<exact>",
        "runtime_generated_at": "<exact>",
        "frontier_generated_at": "<exact>",
        "scoreboard_generated_at": "<exact>",
        "leader_score": "<number or explicit NONE>",
        "champion_reproducible": "<boolean>",
        "guide_brief_generated_at": "<exact>",
        "previous_visible_response_ref": "<exact>"
      },
      "previous_visible_response_read": true,
      "contradictions_found": [],
      "implicated_projects": []
    },
    "20_ACTED": {
      "schema": "prometeo.guide-takeover-phase/v1",
      "canary_id": "TKV1",
      "session_id": "<same>",
      "phase": "20_ACTED",
      "created_at": "<ISO8601>",
      "material_actions": [
        {
          "action_type": "<one allowed type>",
