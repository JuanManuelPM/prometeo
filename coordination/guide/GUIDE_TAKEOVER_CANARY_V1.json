      "phase": "30_FINAL",
      "created_at": "<ISO8601>",
      "canary_result": "PASS",
      "visible_response_ref": "coordination/guide/visible-responses/<same-session_id>.md",
      "changed_refs": [
        "<all material changed refs>"
      ],
      "power_levers": [
        {
          "kind": "EXECUTED_NOW",
          "name": "<lever>",
          "mechanism": "<mechanism>"
        },
        {
          "kind": "NEAR_TERM",
          "name": "<lever>",
          "mechanism": "<mechanism>"
        },
        {
          "kind": "STRUCTURAL_CREATIVE",
          "name": "<lever>",
          "mechanism": "<mechanism>"
        }
      ],
      "relevant_page_urls": [
        "<direct URL 1>",
        "<direct URL 2>",
        "<direct URL 3>"
      ],
      "human_action": "NONE or exact one action",
      "next_guide_cycle": "<already-derived next cycle>",
      "verification_refs": [
        "<CI/test/evidence refs>"
      ]
    }
  },
  "template_law": "Use these exact top-level field names. Extra fields are allowed. Takeover bookkeeping itself does not count as the material action."
}
