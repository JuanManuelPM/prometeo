{
  "schema": "prometeo.guide-useful-reserve-policy/v1",
  "status": "CANARY",
  "extends": "coordination/guide/METABOLISM_POLICY_V1.json",
  "authority_boundary": "This policy refines Guide/Metabolism admission and ordering only. It creates no scheduler, queue, worker family, launch authority or preemption authority.",
  "priority_order": [
    "HUMAN_DURABLE_INTENT",
    "CURRENT_PRODUCT_WORK",
    "INTEGRATION_VERIFICATION_RECOVERY",
    "USEFUL_RESERVE"
  ],
  "reserve_admission": {
    "all_required": [
      "no_higher_priority_claimable_work",
      "durable_evidence_ref_present",
      "current_owner_present",
      "downstream_consumer_present",
      "done_when_present",
      "observable_change_present"
    ],
    "allowed_evidence_classes": [
      "REPEATED_EXIT_AUDIT_FRICTION",
      "UNCONSUMED_RETURN",
      "PENDING_REGRESSION_OR_HARNESS",
      "STALE_PROJECTION",
      "SEMANTIC_DEDUP_OR_DEBT",
      "PLANNER_CONTRACT_COMPLIANCE",
      "VERIFICATION_DEBT",
      "RECOVERY_DEBT",
      "DECISION_CHANGING_BENCHMARK"
    ],
    "reject_if": [
      "only_reason_is_idle_shell_capacity",
      "consumer_missing",
      "done_when_missing",
      "observable_change_missing",
      "evidence_missing"
    ]
  },
  "reserve_target": {
    "rule": "min(verified_reserve_candidates, max(0, metabolism_target_claimable - higher_priority_claimable))",
    "floor": 0,
    "hardcoded_occupancy_forbidden": true,
    "task_count_growth_forbidden": true
  },
  "reactive_human_priority": {
    "trigger": "new durable human intent represented by an existing CURRENT portfolio/work-graph owner",
    "effect": "new allocation and resident E8 reentry prefer the human intent over unstarted reserve work",
    "started_exclusive_work": "never cancel or steal authority; allow current STARTED mutation to reach its normal safe boundary",
    "special_chat_pool_forbidden": true
  },
  "reserve_item_contract": {
    "required": ["owner_current", "consumer", "done_when", "evidence", "observable_change"],
    "terminal_without_consumption": "does_not_count_as_growth"
  },
  "measurement": {
    "required_receipt_fields": [
      "higher_priority_claimable_before",
      "verified_reserve_candidates_before",
      "reserve_admitted",
      "human_intent_arrival_step_or_null",
      "allocation_steps_until_human_work",
      "reserve_jobs_consumed_downstream"
    ],
    "truth_boundary": "Deterministic harness steps are policy evidence, not wall-clock latency. Wall-clock before/after claims require live allocator observations."
  }
}
