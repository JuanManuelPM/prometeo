{
  "schema": "prometeo.guide-work-trace-schema/v1",
  "status": "ACTIVE_BINDING",
  "coordinator": {
    "guide_code": "GUIDE-2",
    "agent_id": "guide-20260922T1343-03-7c4e91",
    "mode": "COORDINATOR_GATED"
  },
  "start": {
    "rpc": "public.prometeo_guide_mesh_work_start",
    "required": [
      "agent_id",
      "claim_key",
      "objective",
      "reasoning_summary",
      "control_questions",
      "planned_actions"
    ],
    "note": "reasoning_summary is concise decision rationale, not private chain-of-thought"
  },
  "review": {
    "rpc": "public.prometeo_guide_mesh_review_work",
    "executor_default": "PENDING_APPROVAL",
    "coordinator_default": "SELF_APPROVED_WITH_TRACE"
  },
  "claim": {
    "rpc": "public.prometeo_guide_mesh_claim",
    "prerequisite": "latest matching Work Trace status APPROVED/ACTIVE"
  },
  "finish": {
    "rpc": "public.prometeo_guide_mesh_work_finish",
    "required": [
      "agent_id",
      "claim_key",
      "reasoning_summary",
      "actions_performed",
      "response_text",
      "verification",
      "artifacts",
      "remaining_gaps"
    ],
    "derived": [
      "response_word_count",
      "duration_seconds"
    ],
    "note": "response_text is used for server-side word counting; the Work Trace stores the count rather than private reasoning"
  },
  "metrics_view": "public.prometeo_guide_mesh_metrics_v1",
  "metrics": [
    "work_items_started",
    "pending_approval",
    "active_work",
    "work_items_done",
    "total_response_words",
    "avg_response_words",
    "control_questions_count",
    "actions_performed_count",
    "avg_work_seconds"
  ],
  "free_without_approval": [
    "read",
    "inspect",
    "search",
    "analyze",
    "critique",
    "publish OBSERVATION",
    "publish proposal"
  ],
  "gated": [
    "Git/Supabase mutation",
    "runtime/schema change",
    "UI/TV write",
    "deploy/publish",
    "protocol/authority change",
    "promotion/integration"
  ]
}
