{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometeo.context-fabric-schema/v1",
  "title": "Prometeo Context Fabric Lite P1 contracts",
  "status": "CANDIDATE_P1",
  "$defs": {
    "artifact": {"type":"object","required":["artifact_id","identity_basis","path","namespace_id","kind","content_hash","metadata_hash","source_head","status","authority_class","privacy_class","outbound_refs","extraction_warnings"]},
    "edge": {"type":"object","required":["edge_id","src_id","edge_type","dst_ref","evidence_ref","evidence_pointer","source_head"]},
    "build_state": {"type":"object","required":["generator_version","config_hash","source_head","inventory_hash","graph_hash","namespace_hash","index_hash","file_count","edge_count"]},
    "working_set": {"type":"object","required":["receipt_id","source_head","index_hash","artifacts"]},
    "receipt": {"type":"object","required":["receipt_id","actor_role","mission","source_head","config_hash","index_hash","query_plan_version","selection_provenance","mandatory_closure","selected_artifacts","omitted_but_available_refs","authority_labels","contradictions","freshness","token_estimate","file_count","budget","candidate_counts"]}
  },
  "laws": [
    "Explicit durable identity outranks path fallback.",
    "Authority, privacy, freshness and explicit contradiction closure are hard constraints, never relevance scores.",
    "Only optional evidence is budget-prunable.",
    "Similarity never creates Current/Human Accepted/Served authority.",
    "A receipt proves automated use only when selection_provenance is AUTOMATED_CONTEXT_COMPILER and source/index hashes validate."
  ]
}
