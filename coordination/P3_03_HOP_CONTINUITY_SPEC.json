    "must_preserve": [
      "current_revision",
      "last_receipt_id",
      "last_receipt_hash",
      "phase",
      "next_gate",
      "pending_frontier",
      "carry_invariants",
      "watermarks",
      "catalog_identity",
      "visible_frontend",
