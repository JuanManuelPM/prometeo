{
  "schema": "prometeo.p3-03-hop-continuity-spec/v1",
  "gate": "P3-03",
  "name": "hop-continuity",
  "goal": "Prove that Prometeo can cross clean process and clean browser-session boundaries using durable authority only, without hidden singleton or conversation state.",
  "entry_receipt": "R-P3-02-FRESH-0007",
  "entry_revision": 6,
  "required_process_hops": 3,
  "required_browser_sessions": 2,
  "process_contract": {
    "transport": "stdin-json",
    "child_repo_access": false,
    "child_network_access": false,
    "chat_history": false,
