  },
  "truth_laws": [
    "Chat history is not authority",
    "Execution Packet is scoped transport, not Current",
    "A normal change request is a delta against Current, not permission to reconstruct",
    "Candidate != Human Accepted != Served",
    "Source commit is not Served verification",
    "Page Change Feed is a projection",
    "Private Capture literals never go in public coordination",
    "A disposable worker must release its active write claim when complete or blocked"
  ]
