  "required_agent_cycle": ["LOAD_CONSTITUTION","FETCH","VALIDATE","REINCARNATE","RESYNC","CLAIM","RESOLVE_OWNER","RECOVER_THREAD","PREWRITE","EXECUTE","TEST","PERSIST","RETURN","RECEIPT","UPDATE_THREAD","RELEASE"],
  "write_guard": {
    "default_mutation": "SURGICAL_PRESERVE_FIRST_DELTA",
