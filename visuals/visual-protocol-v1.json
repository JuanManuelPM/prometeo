{
  "id": "PROMETEO_VISUAL_PROTOCOL_V1",
  "status": "CURRENT",
  "core_rule": "IMAGE_FIRST",
  "hard_prohibitions": [
    "primitive-built characters as final art",
    "wireframe/ellipse/ring-only spaces",
    "procedural placeholder textures as final art",
    "generic techno-retro HUD made from empty boxes and labels",
    "promotion of debug geometry as finished visual design"
  ],
  "preferred_sources": [
    "existing Prometeo/Coliseo visual language",
    "user-provided images",
    "original generated or painted assets",
    "public-domain/CC0/appropriately licensed assets"
  ],
  "acceptance": [
    "recognizable visual identity without labels",
    "main asset visually strong before animation",
    "code amplifies assets rather than substitutes for them",
    "mobile landscape remains legible",
    "no primitive placeholder characters/spaces"
  ],
  "corrective_targets": {
    "trail": {
      "keep": [
        "movement loop",
        "bounce",
        "history",
        "cheap compositing"
      ],
      "replace": [
        "procedural creature",
        "soft generic alpha trail"
      ],
      "direction": [
        "strong image asset",
        "hard stamp repetition",
        "rebound composition"
      ]
    },
    "spaces": {
      "keep": [
        "camera",
        "projection",
        "movement",
        "scene switching"
      ],
      "replace": [
        "procedural textures",
        "ring/ellipse tunnel",
        "debug-like architecture"
      ],
      "direction": [
        "Coliseo materials",
        "real textures",
        "cutout/image-heavy architecture"
      ]
    },
    "player": {
      "keep": [
        "low resolution",
        "touch",
        "vibration/audio",
        "state machine"
      ],
      "replace": [
        "polygon hand",
        "code-drawn entities",
        "generic HUD"
      ],
      "direction": [
        "sprite hand",
        "sprite objects",
        "persistent scene",
        "illustrated/diegetic UI"
      ]
    }
  }
}