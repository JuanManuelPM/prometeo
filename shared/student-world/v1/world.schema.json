{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"prometeo.student-world/v1",
  "type":"object",
  "required":["id","nodes"],
  "properties":{
    "id":{"type":"string"},
    "studentId":{"type":["string","null"]},
    "title":{"type":"string"},
    "axis":{"enum":["vertical","horizontal"]},
    "nodes":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["id","title"],
        "properties":{
          "id":{"type":"string"},
          "title":{"type":"string"},
          "kind":{"type":"string"},
          "requires":{"type":"array","items":{"type":"string"}},
          "pageId":{"type":["string","null"]},
          "themeKey":{"type":["string","null"]}
        }
      }
    }
  }
}
