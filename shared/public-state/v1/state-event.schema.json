{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juanmanuelpm.github.io/prometeo/shared/public-state/v1/state-event.schema.json",
  "title": "Prometeo Public State Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "workspace_id",
    "channel",
    "key",
    "value_json",
    "version",
    "source",
    "source_version",
    "visibility",
    "occurred_at"
  ],
  "properties": {
    "schema": { "const": "prometeo.public-state-event/v1" },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "workspace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "channel": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$",
      "maxLength": 240
    },
    "value_json": true,
    "version": { "type": "integer", "minimum": 1 },
    "source": { "type": "string", "minLength": 1, "maxLength": 160 },
    "source_version": { "type": "integer", "minimum": 1 },
    "schema_id": { "type": ["string", "null"], "maxLength": 240 },
    "visibility": {
      "type": "string",
      "enum": ["workspace", "channel", "public_anonymous"]
    },
    "operation_id": { "type": ["string", "null"], "maxLength": 160 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "provenance": { "type": "object", "additionalProperties": true, "maxProperties": 16 }
  }
}
