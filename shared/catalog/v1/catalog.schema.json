{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"prometeo.catalog-manifest/v1",
  "type":"object",
  "required":["schema","source_contract","pages"],
  "properties":{
    "schema":{"const":"prometeo.catalog-manifest/v1"},
    "source_contract":{"type":"object","required":["tree","pages","expected_page_count","identity"]},
    "pages":{"type":"array","items":{"type":"object","required":["page_id","title","category_path","source_identity","href","artifact_state","authority","last_verified"]}}
  }
}
