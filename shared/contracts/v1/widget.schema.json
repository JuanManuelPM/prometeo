{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"prometeo.widget-contract/v1",
  "title":"Prometeo Widget Contract",
  "type":"object",
  "required":["id","version","status","owner","host_contract","input"],
  "properties":{
    "id":{"type":"string"},
    "version":{"type":"string"},
    "status":{"enum":["CANDIDATE","HUMAN_ACCEPTED","ARCHIVED"]},
    "owner":{"type":"string"},
    "host_contract":{"type":"object","required":["mount","unmount"],"properties":{"mount":{"type":"string"},"unmount":{"type":"string"},"serialize":{"type":["string","null"]},"restore":{"type":["string","null"]}}},
    "input":{"type":"object","required":["ownership"],"properties":{"ownership":{"enum":["HOST","WIDGET","LEASED"]},"lease_scope":{"type":["string","null"]}}},
    "modes":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "dependencies":{"type":"array","items":{"type":"string"}},
    "tests":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties":true
}
