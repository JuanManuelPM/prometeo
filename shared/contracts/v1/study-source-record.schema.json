{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometeo.study-source-record/v1",
  "title": "Study Source Record v1",
  "type": "object",
  "required": ["schema", "source_id", "provider", "item_type", "title", "captured_at", "provenance", "raw_metadata"],
  "properties": {
    "schema": {"const": "prometeo.study-source-record/v1"},
    "source_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "provider_course_id": {"type": ["string", "null"]},
    "course_id": {"type": ["string", "null"]},
    "provider_item_id": {"type": ["string", "null"]},
    "item_type": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "body_text": {"type": ["string", "null"], "description": "Verbatim/source-captured text only. Never derived metadata."},
    "due_at": {"type": ["string", "null"], "format": "date-time"},
    "modified_at": {"type": ["string", "null"], "format": "date-time"},
    "captured_at": {"type": "string", "format": "date-time"},
    "source_url": {"type": ["string", "null"]},
    "reopen_handle": {"type": ["string", "null"]},
    "source_page": {"type": ["string", "null"]},
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attachment_id"],
        "properties": {
          "attachment_id": {"type": "string"},
          "title": {"type": ["string", "null"]},
          "source_url": {"type": ["string", "null"]},
          "private_ref": {"type": ["string", "null"]},
          "mime_type": {"type": ["string", "null"]},
          "size_bytes": {"type": ["integer", "null"], "minimum": 0},
          "content_hash": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "provenance": {"type": "object"},
    "raw_metadata": {"type": "object", "description": "Provider metadata only; do not insert derived text here."}
  },
  "additionalProperties": false
}
