{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"prometeo.study-derived-event/v1",
  "title":"Study Derived Event v1",
  "type":"object",
  "required":["schema","event_id","title","starts_at","event_type","source_id","source_locator","extraction_confidence","extraction_status","provenance"],
  "properties":{
    "schema":{"const":"prometeo.study-derived-event/v1"},
    "event_id":{"type":"string","minLength":1},
    "title":{"type":"string"},
    "starts_at":{"type":"string","format":"date-time"},
    "ends_at":{"type":["string","null"],"format":"date-time"},
    "all_day":{"type":"boolean"},
    "event_type":{"enum":["exam","makeup_exam","assignment_due","no_class","class","important_date"]},
    "course_id":{"type":["string","null"]},
    "source_id":{"type":"string","minLength":1},
    "document_id":{"type":["string","null"]},
    "source_locator":{"type":"object"},
    "extraction_confidence":{"type":"string"},
    "extraction_status":{"enum":["candidate","derived","derived-unmapped-course","conflict","rejected"]},
    "conflict_group_id":{"type":["string","null"]},
    "provenance":{"type":"object"}
  },
  "additionalProperties":false
}
