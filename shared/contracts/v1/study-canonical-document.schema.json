{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometeo.study-canonical-document/v1",
  "title": "Study Canonical Document v1",
  "type": "object",
  "required": ["schema", "document_id", "source_id", "provider", "document_kind", "title", "captured_at", "canonical_status", "provenance", "raw_metadata"],
  "properties": {
    "schema": {"const": "prometeo.study-canonical-document/v1"},
    "document_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "provider_course_id": {"type": ["string", "null"]},
    "provider_item_id": {"type": ["string", "null"]},
    "course_id": {"type": ["string", "null"]},
    "document_kind": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "source_url": {"type": ["string", "null"]},
    "reopen_handle": {"type": ["string", "null"]},
    "private_ref": {"type": ["string", "null"]},
    "mime_type": {"type": ["string", "null"]},
    "source_modified_at": {"type": ["string", "null"], "format": "date-time"},
    "captured_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": ["string", "null"]},
    "canonical_status": {"enum": ["metadata-only", "source-text", "binary-ready", "extracted"]},
    "provenance": {"type": "object"},
    "raw_metadata": {"type": "object"}
  },
  "additionalProperties": false
}
