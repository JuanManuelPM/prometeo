{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"prometeo.page-contract/v1",
  "title":"Prometeo Page Contract",
  "type":"object",
  "required":["id","version","status","entry","owner","lineage","privacy"],
  "properties":{
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},
    "version":{"type":"string","minLength":1},
    "status":{"enum":["SOURCE","RECOVERED","RECONSTRUCTED","CANDIDATE","HUMAN_ACCEPTED","SERVED","ARCHIVED"]},
    "entry":{"type":"string","minLength":1},
    "owner":{"type":"string","minLength":1},
    "lineage":{"type":"object","required":["id"],"properties":{"id":{"type":"string"},"predecessor":{"type":["string","null"]},"sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"}},"additionalProperties":true},
    "dependencies":{"type":"array","items":{"type":"object","required":["id","version"],"properties":{"id":{"type":"string"},"version":{"type":"string"},"required":{"type":"boolean","default":true}}}},
    "capabilities":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "state":{"type":"object","properties":{"schema":{"type":["string","null"]},"migration":{"type":["string","null"]}}},
    "privacy":{"enum":["LOCAL","SHAREABLE","EXPORTABLE"]},
    "tests":{"type":"array","items":{"type":"string"}},
    "human_acceptance":{"type":"object","properties":{"required":{"type":"boolean"},"accepted_exact_sha256":{"type":["string","null"]}}}
  },
  "additionalProperties":true
}
