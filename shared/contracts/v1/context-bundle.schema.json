{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"prometeo.context-bundle/v1",
  "title":"Prometeo Context Bundle",
  "type":"object",
  "required":["id","task","authority","sources","privacy","generated_from"],
  "properties":{
    "id":{"type":"string"},
    "task":{"type":"object","required":["literal"],"properties":{"literal":{"type":"string"},"scope":{"type":"array","items":{"type":"string"}}}},
    "authority":{"type":"object","properties":{"human_decisions":{"type":"array","items":{"type":"string"}},"invariants":{"type":"array","items":{"type":"string"}},"accepted_artifacts":{"type":"array","items":{"type":"object"}}}},
    "sources":{"type":"array","items":{"type":"object","required":["ref","class","privacy"],"properties":{"ref":{"type":"string"},"class":{"enum":["VERIFIED_EXACT_ARTIFACT","HUMAN_DECISION","PROTOCOL","DERIVED","INFERENCE"]},"privacy":{"enum":["LOCAL","SHAREABLE","EXPORTABLE"]},"sha256":{"type":["string","null"]}}}},
    "privacy":{"enum":["LOCAL","SHAREABLE","EXPORTABLE"]},
    "generated_from":{"type":"array","items":{"type":"string"}},
    "staleness":{"type":"object","properties":{"generated_at":{"type":"string"},"invalidate_on":{"type":"array","items":{"type":"string"}}}}
  },
  "additionalProperties":true
}
