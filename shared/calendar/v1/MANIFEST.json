{
  "schema": "prometeo.shared-component/v1",
  "id": "calendar",
  "version": "1",
  "status": "candidate-integrated",
  "owner": "shared/calendar/v1",
  "public_entry": "pages/calendar/index.html",
  "contract": {
    "owns": [
      "date arithmetic",
      "week projection",
      "recurrence projection",
      "calendar local-state adapter",
      "calendar presentation"
    ],
    "does_not_own": [
      "student identity",
      "university domain semantics",
      "finance truth",
      "habit semantics",
      "food semantics",
      "external sports truth"
    ]
  },
  "dependencies": [
    "shared/interaction/touch-first/v1",
    "shared/material/bicolor/v1"
  ],
  "state": {
    "schema": "prometeo.calendar-state/v1",
    "storage": "localStorage",
    "key": "prometeo.calendar.state.v1",
    "privacy": "personal state is never committed; URL fragment bootstrap is local-only"
  },
  "sources": {
    "boca": "public projection refreshed 2026-09-04; replaceable source adapter"
  },
  "migration": [
    "dated-calendar-classes-v8",
    "dated-calendar-rate-v8",
    "horarios-fijos-paleta-v4",
    "dated-calendar-income-history-v10",
    "prometeo-life-*-v18"
  ],
  "future_consumers": [
    "today",
    "students",
    "university",
    "tasks",
    "habits",
    "food",
    "finance"
  ]
}
