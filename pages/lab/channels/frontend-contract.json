{
  "schema": "prometeo.creator-frontend/v1",
  "backend": "https://catnohyouxqjjtseaueb.supabase.co/functions/v1/creator-api",
  "auth": {
    "type": "supabase-user-jwt",
    "publishable_key_is_public": true,
    "secrets_in_browser": false
  },
  "status_semantics": ["MOCK", "CONFIGURED", "VERIFIED_REAL", "BLOCKED"],
  "resources": {
    "channels": {
      "list": "GET /channels",
      "create": "POST /channels {title,slug?,world?,settings?}"
    },
    "stories": {
      "list": "GET /channels/:channel_id/stories",
      "create": "POST /channels/:channel_id/stories {title,summary?,story_data?}",
      "external_work": "POST /stories/:story_id/work {task}",
      "external_return": "POST creator-work {work_id,token,result}; successful returns auto-apply transactionally when the story version still matches"
    },
    "videos": {
      "list": "GET /channels/:channel_id/videos?state=READY|PUBLISHED|IDEA|...",
      "produce": "POST /videos/:video_id/produce {mode?,generate_voice?,max_cost_cents?}",
      "master": "GET /videos/:video_id/master -> short-lived signed_url",
      "publish": "POST /videos/:video_id/publish {privacy,publish_at?,contains_synthetic_media?}"
    },
    "jobs": {
      "get": "GET /jobs/:job_id",
      "terminal": ["SUCCEEDED", "FAILED", "BLOCKED", "WAITING_AUTH"],
      "recoverable": ["QUEUED", "RETRY", "RUNNING", "WAITING_EXTERNAL"]
    },
    "analytics": {
      "timeline": "GET /channels/:channel_id/timeline?metric=views|subs|retention|ctr|revenue",
      "interval_model": "publication_n_to_publication_n_plus_1"
    },
    "setup": {
      "ensure": "POST /setup/ensure",
      "status": "GET /setup/status",
      "gemini": "POST /setup/provider/gemini {secret}",
      "huggingface_optional": "POST /setup/provider/hf {secret}",
      "google_client": "POST /setup/google-client {client_id,client_secret}",
      "google_start": "POST /google/start {return_to}",
      "video_policy": "POST /setup/video-policy {spend_allowed,max_cost_cents}",
      "fixture_canary": "POST /canary/fixture {channel_id,key?}",
      "handoff": "GET /handoff/export"
    }
  },
  "invariants": [
    "Provider secrets and Google refresh tokens live server-side in Vault only.",
    "Paid video generation requires an explicit spend_allowed=true and a per-video cost ceiling.",
    "Publication uses idempotency keys and resumable upload state.",
    "A WAITING_AUTH publication must not block unrelated generation jobs.",
    "External work tokens grant one work packet only and never grant account/provider access.",
    "UI may use fixtures, but fixtures are identified as fixtures and never represented as real provider output."
  ]
}