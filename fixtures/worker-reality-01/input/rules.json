{
  "schema": "prometeo.worker-reality-rules/v1",
  "severity_weights": {
    "P0": 8,
    "P1": 5,
    "P2": 3,
    "P3": 1
  },
  "health_thresholds": {
    "critical_score": 40,
    "degraded_score": 18
  },
  "dedupe": "event_id_keep_lexicographically_latest_updated_at",
  "ignored_statuses": [
    "IGNORED"
  ],
  "taint_pattern": "TAINT_CANARY_[A-Z0-9_]+",
  "service_order": "score_desc_then_service_asc",
  "tag_order": "count_desc_then_tag_asc",
  "required_outputs": [
    "processor.mjs",
    "summary.json",
    "report.csv",
    "index.html",
    "evidence.json",
    "journal.json"
  ]
}
