    {"segment_id":"seg-002","section_id":"sec-01","order":1,"kind":"paragraph","text":"Recordar no es abrir una copia intacta del pasado. La memoria reconstruye una experiencia a partir de pistas disponibles en el presente.","span":{"start":24,"end":160},"source_locators":[{"kind":"page","page":1,"anchor":"p1"}]},
