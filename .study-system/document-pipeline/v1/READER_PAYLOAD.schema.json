{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometeo.reader-payload/v1",
  "title": "Prometeo Reader Payload v1",
  "type": "object",
  "required": [
    "schema",
    "document_id",
    "title",
    "course_id",
    "language",
    "reader_projection_version_id",
    "canonical_extraction_version_id",
    "source_version_id",
    "offset_unit",
    "sections",
    "segments",
    "paragraphs",
    "readable_text",
    "readable_text_length",
    "provenance_ref"
  ],
  "properties": {
    "schema": {
      "const": "prometeo.reader-payload/v1"
    },
    "document_id": {
      "type": "string",
      "pattern": "^doc1:sha256:[0-9a-f]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "author": {
      "type": [
        "string",
        "null"
      ]
    },
    "course_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "reader_projection_version_id": {
      "type": "string",
      "pattern": "^rpv1:sha256:[0-9a-f]{64}$"
    },
    "canonical_extraction_version_id": {
      "type": "string",
      "pattern": "^cex1:sha256:[0-9a-f]{64}$"
    },
    "source_version_id": {
      "type": "string",
      "pattern": "^srcv1:sha256:[0-9a-f]{64}$"
    },
    "offset_unit": {
      "const": "utf16_code_unit"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "order",
          "segment_ids"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "segment_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "section_id",
          "order",
          "kind",
          "text",
          "span",
          "source_locators"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "heading",
              "paragraph",
              "list_item",
              "quote",
              "caption",
              "code",
              "footnote"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "heading_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "span": {
            "$ref": "#/$defs/span"
          },
          "source_locators": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/sourceLocator"
            }
          },
          "asset_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "paragraph_id",
          "section_id",
          "order",
          "segment_ids",
          "span"
        ],
        "properties": {
          "paragraph_id": {
            "type": "string",
            "minLength": 1
          },
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "segment_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "span": {
            "$ref": "#/$defs/span"
          }
        },
        "additionalProperties": false
      }
    },
    "readable_text": {
      "type": "string"
    },
    "readable_text_length": {
      "type": "integer",
      "minimum": 0
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "kind",
          "mime_type",
          "runtime_ref",
          "visibility",
          "source_locators"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "image",
              "figure",
              "table",
              "diagram",
              "other"
            ]
          },
          "mime_type": {
            "type": "string",
            "minLength": 1
          },
          "alt": {
            "type": [
              "string",
              "null"
            ]
          },
          "runtime_ref": {
            "type": "string",
            "minLength": 1
          },
          "visibility": {
            "enum": [
              "private_runtime",
              "public",
              "unknown"
            ]
          },
          "source_locators": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sourceLocator"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "provenance_ref": {
      "type": "object",
      "required": [
        "document_id",
        "source_version_id",
        "canonical_extraction_version_id",
        "provenance_ids"
      ],
      "properties": {
        "document_id": {
          "type": "string"
        },
        "source_version_id": {
          "type": "string"
        },
        "canonical_extraction_version_id": {
          "type": "string"
        },
        "provenance_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "sourceLocator": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "page"
          ],
          "properties": {
            "kind": {
              "const": "page"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "bbox": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            },
            "anchor": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "block_key"
          ],
          "properties": {
            "kind": {
              "const": "block"
            },
            "block_key": {
              "type": "string",
              "minLength": 1
            },
            "anchor": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "start",
            "end"
          ],
          "properties": {
            "kind": {
              "const": "source_text_range"
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            },
            "offset_unit": {
              "enum": [
                "utf16_code_unit",
                "unicode_code_point",
                "utf8_byte"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "const": "opaque"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
