{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometeo.tts-chunk-set/v1",
  "title": "Prometeo TTS Chunk Set v1",
  "type": "object",
  "required": [
    "schema",
    "document_id",
    "reader_projection_version_id",
    "tts_projection_version_id",
    "language",
    "offset_unit",
    "chunker",
    "chunks"
  ],
  "properties": {
    "schema": {
      "const": "prometeo.tts-chunk-set/v1"
    },
    "document_id": {
      "type": "string",
      "pattern": "^doc1:sha256:[0-9a-f]{64}$"
    },
    "reader_projection_version_id": {
      "type": "string",
      "pattern": "^rpv1:sha256:[0-9a-f]{64}$"
    },
    "tts_projection_version_id": {
      "type": "string",
      "pattern": "^ttsp1:sha256:[0-9a-f]{64}$"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "offset_unit": {
      "const": "utf16_code_unit"
    },
    "chunker": {
      "type": "object",
      "required": [
        "id",
        "version",
        "max_chars",
        "include_kinds"
      ],
      "properties": {
        "id": {
          "const": "reader-sentence-pack"
        },
        "version": {
          "type": "string"
        },
        "max_chars": {
          "type": "integer",
          "minimum": 32
        },
        "include_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chunk_id",
          "order",
          "text",
          "reader_span",
          "links"
        ],
        "properties": {
          "chunk_id": {
            "type": "string",
            "pattern": "^ttsc1:sha256:[0-9a-f]{64}$"
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "reader_span": {
            "$ref": "#/$defs/span"
          },
          "links": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "segment_id",
                "reader_span",
                "segment_span",
                "chunk_span"
              ],
              "properties": {
                "segment_id": {
                  "type": "string",
                  "minLength": 1
                },
                "reader_span": {
                  "$ref": "#/$defs/span"
                },
                "segment_span": {
                  "$ref": "#/$defs/span"
                },
                "chunk_span": {
                  "$ref": "#/$defs/span"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
