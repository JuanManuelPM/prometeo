  "segments": [
    {"segment_id":"seg-001","section_id":"sec-01","order":0,"kind":"heading","heading_level":1,"text":"Memoria reconstructiva","source_locators":[{"kind":"page","page":1}]},
    {"segment_id":"seg-002","section_id":"sec-01","order":1,"kind":"paragraph","text":"Recordar no es abrir una copia intacta del pasado. La memoria reconstruye una experiencia a partir de pistas disponibles en el presente.","source_locators":[{"kind":"page","page":1,"anchor":"p1"}]},
    {"segment_id":"seg-003","section_id":"sec-01","order":2,"kind":"paragraph","text":"Dos personas pueden vivir la misma escena y conservar detalles distintos porque atendieron señales diferentes.","source_locators":[{"kind":"page","page":1,"anchor":"p2"}]},
    {"segment_id":"seg-004","section_id":"sec-02","order":3,"kind":"heading","heading_level":1,"text":"Estudiar recuperando","source_locators":[{"kind":"page","page":2}]},
    {"segment_id":"seg-005","section_id":"sec-02","order":4,"kind":"paragraph","text":"Releer puede producir familiaridad, pero recuperar una idea sin mirar el material ejercita la ruta que después necesitamos para explicarla.","source_locators":[{"kind":"page","page":2,"anchor":"p1"}]},
    {"segment_id":"seg-006","section_id":"sec-02","order":5,"kind":"paragraph","text":"Los ejemplos agregan nuevas pistas y conectan una definición abstracta con situaciones concretas.","source_locators":[{"kind":"page","page":2,"anchor":"p2"}]}
  ],
