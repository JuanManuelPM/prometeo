{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prometeo.canonical-document/v1",
  "title": "Prometeo Canonical Document v1",
  "type": "object",
  "required": [
    "schema",
    "document_id",
    "title",
    "course_id",
    "language",
    "source",
    "extraction",
    "sections",
    "segments"
  ],
  "properties": {
    "schema": {
      "const": "prometeo.canonical-document/v1"
    },
    "document_id": {
      "type": "string",
      "pattern": "^doc1:sha256:[0-9a-f]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "author": {
      "type": [
        "string",
        "null"
      ]
    },
    "course_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "source": {
      "type": "object",
      "required": [
        "source_version_id",
        "content_sha256",
        "hash_basis",
        "media_type",
        "provenance"
      ],
      "properties": {
        "source_version_id": {
          "type": "string",
          "pattern": "^srcv1:sha256:[0-9a-f]{64}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hash_basis": {
          "enum": [
            "raw_bytes",
            "normalized_source_envelope"
          ]
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "provenance_id",
              "provider",
              "runtime_ref",
              "visibility"
            ],
            "properties": {
              "provenance_id": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "runtime_ref": {
                "type": "string",
                "minLength": 1
              },
              "visibility": {
                "enum": [
                  "private_runtime",
                  "public",
                  "unknown"
                ]
              },
              "observed_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "extraction": {
      "type": "object",
      "required": [
        "canonical_extraction_version_id",
        "extractor_id",
        "extractor_version",
        "extractor_config_sha256",
        "canonical_content_sha256"
      ],
      "properties": {
        "canonical_extraction_version_id": {
          "type": "string",
          "pattern": "^cex1:sha256:[0-9a-f]{64}$"
        },
        "extractor_id": {
          "type": "string",
          "minLength": 1
        },
        "extractor_version": {
          "type": "string",
          "minLength": 1
        },
        "extractor_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "canonical_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "order",
          "segment_ids"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "segment_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "section_id",
          "order",
          "kind",
          "text",
          "source_locators"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "heading",
              "paragraph",
              "list_item",
              "quote",
              "caption",
              "code",
              "footnote"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "heading_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "source_locators": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/sourceLocator"
            }
          },
          "asset_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "kind",
          "mime_type",
          "runtime_ref",
          "visibility",
          "source_locators"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "image",
              "figure",
              "table",
              "diagram",
              "other"
            ]
          },
          "mime_type": {
            "type": "string",
            "minLength": 1
          },
          "alt": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "runtime_ref": {
            "type": "string",
            "minLength": 1
          },
          "visibility": {
            "enum": [
              "private_runtime",
              "public",
              "unknown"
            ]
          },
          "source_locators": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/sourceLocator"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sourceLocator": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "page"
          ],
          "properties": {
            "kind": {
              "const": "page"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "bbox": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            },
            "anchor": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "block_key"
          ],
          "properties": {
            "kind": {
              "const": "block"
            },
            "block_key": {
              "type": "string",
              "minLength": 1
            },
            "anchor": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "start",
            "end"
          ],
          "properties": {
            "kind": {
              "const": "source_text_range"
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 0
            },
            "offset_unit": {
              "enum": [
                "utf16_code_unit",
                "unicode_code_point",
                "utf8_byte"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "const": "opaque"
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
