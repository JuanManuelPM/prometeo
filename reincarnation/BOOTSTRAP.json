{
  "schema": "prometeo.reincarnation-bootstrap/v1",
  "version": "1.0.0-candidate",
  "required": [
    {
      "role": "current_graph",
      "path": "state/CURRENT_GRAPH.json",
      "schema": "prometeo.current-graph/v1"
    },
    {
      "role": "head",
      "path": "state/HEAD.json",
      "schema": "prometeo.head/v1"
    },
    {
      "role": "dot_state",
      "path": "state/DOT_STATE.json",
      "schema": "prometeo.dot-state/v1"
    },
    {
      "role": "parent",
      "path": "state/PARENT.json",
      "schema": "prometeo.parent/v1"
    },
    {
      "role": "pending",
      "path": "state/PENDING.json",
      "schema": "prometeo.pending/v1"
    },
    {
      "role": "carry",
      "path": "state/CARRY.json",
      "schema": "prometeo.carry/v1"
    },
    {
      "role": "watermarks",
      "path": "state/WATERMARKS.json",
      "schema": "prometeo.watermarks/v1"
    },
    {
      "role": "catalog",
      "path": "catalog/CATALOG_MANIFEST.json",
      "schema": "prometeo.catalog-manifest/v1"
    },
    {
      "role": "lineage",
      "path": "lineage/LINEAGE_GRAPH.json",
      "schema": "prometeo.lineage-graph/v1"
    },
    {
      "role": "capabilities",
      "path": "lineage/CAPABILITY_REGISTRY.json",
      "schema": "prometeo.capability-registry/v1"
    },
    {
      "role": "hot_book",
      "path": "context/books/HOT.json",
      "schema": "prometeo.context-book/v1"
    },
    {
      "role": "ledger",
      "path": "receipts/ledger.jsonl",
      "schema": "prometeo.receipt/v1"
    }
  ],
  "wake_contract": {
    "must_answer": [
      "WHAT_IS_PROMETEO",
      "CURRENT",
      "HUMAN_ACCEPTED_SCOPES",
      "SERVED_INHERITED",
      "ACTIVE_FRONTEND",
      "PAGES",
      "CAPABILITIES",
      "PENDING",
      "RULES",
      "HOW_TO_CHANGE",
      "HOW_TO_TEST",
      "HOW_TO_RELEASE"
    ],
    "must_not_require": [
      "chat_history",
      "worker_memory",
      "highest_version_guess"
    ],
    "privacy_default": "LOCAL"
  }
}
